# Private strategies and their data/results live in independent repositories.
# TradeEngine contains only Engine-owned source and BuiltIn resources.
/strategies/
/data/
/results/

bin/
obj/
TestResults/
*.trx

# The vendored Kanna fork is a first-class TradeEngine component. Its launcher
# and image assets must remain tracked even though the repository-wide rules
# ignore generic build output and screenshots elsewhere.
!/agent_web/bin/
!/agent_web/bin/**
!/agent_web/assets/**/*.png
!/agent_web/src/**/*.png
